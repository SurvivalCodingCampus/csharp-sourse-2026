@startuml
scale .75
skinparam classAttributeIconSize 0

' 과제 2: 과제 1 구조에 게임 규칙을 담당하는 Service와 성공/실패 결과를 추가한다.
' +는 외부 공개, -는 내부 전용이며 Task는 비동기 작업을 나타낸다.

' record의 위치 매개변수와 자동 생성 속성을 UML 생성자와 get/init 속성으로 표현한다.
' Service 생성자는 C# 기본 생성자(primary constructor) 주입을 나타낸다.
' 과제 2는 Service 계층 중심의 요약도로, 과제 1의 보드/타일/목표 모델은 생략한다.



' ==================================================
' 데이터 모델
' ==================================================

package "Data.Models" {

    ' 플레이어의 식별자, 닉네임, 아바타 정보를 보관한다.
    class PlayerProfile <<record>> {
        {field} +string PlayerId { get; init; }
        {field} +string Nickname { get; init; }
        {field} +string AvatarId { get; init; }
        +PlayerProfile(string PlayerId, string Nickname, string AvatarId)
    }

    ' 프로필과 분리하여 코인과 황금 열쇠 보유량을 나타낸다.
    class Wallet <<record>> {
        {field} +int Coins { get; init; }
        {field} +int GoldenKeys { get; init; }
        +Wallet(int Coins, int GoldenKeys)
    }

    ' 음악, 효과음, 언어 등 사용자 설정을 보관한다.
    class GameSettings <<record>> {
        {field} +bool BgmEnabled { get; init; }
        {field} +bool SfxEnabled { get; init; }
        {field} +string Language { get; init; }
        +GameSettings(bool BgmEnabled, bool SfxEnabled, string Language)
    }

    ' 레벨 이름과 이동 제한 등 게임의 기본 데이터를 나타낸다.
    class Level <<record>> {
        {field} +int Id { get; init; }
        {field} +string Name { get; init; }
        {field} +int MoveLimit { get; init; }
        +Level(int Id, string Name, int MoveLimit)
    }

    ' 플레이어별 잠금 해제, 클리어 여부, 별과 최고 점수를 기록한다.
    class LevelProgress <<record>> {
        {field} +int LevelId { get; init; }
        {field} +bool IsUnlocked { get; init; }
        {field} +bool IsCleared { get; init; }
        {field} +int Stars { get; init; }
        {field} +int BestScore { get; init; }
        +LevelProgress(int LevelId, bool IsUnlocked, bool IsCleared, int Stars, int BestScore)
    }

    ' 미션 내용과 현재 진행량, 목표량, 보상 수령 상태를 나타낸다.
    class Mission <<record>> {
        {field} +int Id { get; init; }
        {field} +string Title { get; init; }
        {field} +int CurrentProgress { get; init; }
        {field} +int TargetProgress { get; init; }
        {field} +MissionStatus Status { get; init; }
        +Mission(int Id, string Title, int CurrentProgress, int TargetProgress, MissionStatus Status)
    }

    ' 미션 진행 중, 완료, 보상 수령 완료를 구분한다.
    enum MissionStatus {
        InProgress
        Completed
        RewardClaimed
    }

    ' 지급할 보상의 수량을 나타내며 실제 지급은 Service에서 처리한다.
    class Reward <<record>> {
        {field} +int Coins { get; init; }
        {field} +int GoldenKeys { get; init; }
        +Reward(int Coins, int GoldenKeys)
    }

    ' 현재 플레이 중인 레벨의 점수, 남은 이동 횟수, 상태를 보관한다.
    class GameSession <<record>> {
        {field} +int LevelId { get; init; }
        {field} +int Score { get; init; }
        {field} +int RemainingMoves { get; init; }
        {field} +GameState State { get; init; }
        +GameSession(int LevelId, int Score, int RemainingMoves, GameState State)
    }

    ' 게임의 준비, 진행, 승리, 패배 상태를 구분한다.
    enum GameState {
        Ready
        Playing
        Win
        Lose
    }
}


' ==================================================
' 성공 / 실패 결과
' ==================================================

package "Common" {

    ' 성공 데이터 또는 실패 원인 중 하나를 담는 공통 결과 타입이다.
    abstract class "Result<TData, TError>" as Result <<record>> {
        -Result()
    }

    ' 작업에 성공했을 때 반환할 데이터를 담는다.
    class "Result<TData, TError>.Success" as ResultSuccess <<sealed record>> {
        {field} +TData Data { get; init; }
        +Success(TData Data)
    }

    ' 작업에 실패했을 때 오류 원인을 담는다.
    class "Result<TData, TError>.Failure" as ResultFailure <<sealed record>> {
        {field} +TError Error { get; init; }
        +Failure(TError Error)
    }

    ' <|--는 상속 관계로, Success와 Failure가 공통 Result 타입을 따른다.
    Result <|-- ResultSuccess
    Result <|-- ResultFailure
}

package "Common.Error" {

    ' 데이터 접근 실패와 게임 규칙 위반의 원인을 구분한다.
    enum GameError {
        NotFound
        NetworkError
        InvalidNickname
        InvalidAmount
        InsufficientCoins
        LevelLocked
        MissionNotCompleted
        RewardAlreadyClaimed
    }
}


' ==================================================
' Repository 인터페이스
' ==================================================

package "Data.Interfaces" {

    ' 프로필을 조회하고 저장하는 계약이다.
    interface IProfileRepository {
        +Task<PlayerProfile> GetProfileAsync()
        +Task SaveProfileAsync(PlayerProfile profile)
    }

    ' 재화를 조회하고 저장하며 소비 가능 여부는 판단하지 않는다.
    interface IWalletRepository {
        +Task<Wallet> GetWalletAsync()
        +Task SaveWalletAsync(Wallet wallet)
    }

    ' 사용자 설정을 조회하고 저장하는 계약이다.
    interface ISettingsRepository {
        +Task<GameSettings> GetSettingsAsync()
        +Task SaveSettingsAsync(GameSettings settings)
    }

    ' 레벨 목록과 특정 레벨의 기본 데이터를 조회한다.
    interface ILevelRepository {
        +Task<List<Level>> GetLevelsAsync()
        +Task<Level> GetLevelAsync(int levelId)
    }

    ' 레벨별 플레이어 진행도를 조회하고 저장한다.
    interface IProgressRepository {
        +Task<List<LevelProgress>> GetProgressListAsync()
        +Task<LevelProgress> GetProgressAsync(int levelId)
        +Task SaveProgressAsync(LevelProgress progress)
    }

    ' 미션 데이터를 조회하고 저장하며 보상 수령 규칙은 Service에 둔다.
    interface IMissionRepository {
        +Task<List<Mission>> GetMissionsAsync()
        +Task<Mission> GetMissionAsync(int missionId)
        +Task SaveMissionAsync(Mission mission)
    }

    ' 현재 게임 세션을 조회, 저장, 삭제하는 계약이다.
    interface IGameSessionRepository {
        +Task<GameSession> GetSessionAsync()
        +Task SaveSessionAsync(GameSession session)
        +Task DeleteSessionAsync()
    }
}


' ==================================================
' Service 계층
' ==================================================

package "Services" {

    ' 닉네임 등 프로필 입력을 검사한 뒤 변경 내용을 저장한다.
    class ProfileService <<primary constructor>> {
        +ProfileService(IProfileRepository profileRepository)

        +Task<Result<PlayerProfile, GameError>> UpdateProfileAsync(string nickname, string avatarId)
    }


    ' 보상 추가와 재화 소비 규칙을 적용하고 지갑을 갱신한다.
    class WalletService <<primary constructor>> {
        +WalletService(IWalletRepository walletRepository)

        +Task<Result<Wallet, GameError>> AddRewardAsync(Reward reward)

        +Task<Result<Wallet, GameError>> SpendCoinsAsync(int amount)
    }


    ' 레벨 진입 조건을 판단하고 클리어 기록을 갱신한다.
    class ProgressService <<primary constructor>> {
        +ProgressService(ILevelRepository levelRepository, IProgressRepository progressRepository)

        +Task<Result<LevelProgress, GameError>> CanEnterLevelAsync(int levelId)

        +Task<Result<LevelProgress, GameError>> CompleteLevelAsync(int levelId, int score, int stars)
    }


    ' 미션 완료와 중복 수령 여부를 검사하고 미션과 지갑 저장을 조합한다.
    class MissionService <<primary constructor>> {
        +MissionService(IMissionRepository missionRepository, IWalletRepository walletRepository)

        +Task<Result<Reward, GameError>> ClaimRewardAsync(int missionId)
    }


    ' 게임 시작, 진행 상태 저장, 종료 등 세션 흐름을 관리한다.
    class GameSessionService <<primary constructor>> {
        +GameSessionService(ILevelRepository levelRepository, IProgressRepository progressRepository, IGameSessionRepository sessionRepository)

        +Task<Result<GameSession, GameError>> StartGameAsync(int levelId)

        +Task<Result<GameSession, GameError>> SaveGameAsync(GameSession session)

        ' 종료 시 진행도 갱신과 세션 관리의 책임이 겹치지 않도록 구현한다.
        +Task<Result<GameSession, GameError>> FinishGameAsync(GameSession session)
    }
}


' ==================================================
' 모델 관계
' ==================================================

Mission --> MissionStatus
Mission --> Reward

GameSession --> GameState

' 레벨 기본 정보와 진행 기록은 분리하며, 진행 기록이 아직 없을 수도 있다.
Level "1" -- "0..1" LevelProgress


' ==================================================
' Service 계층 의존성
' ==================================================

' Service는 구체 저장소 대신 인터페이스를 생성자로 전달받아 사용한다.
ProfileService --> IProfileRepository

WalletService --> IWalletRepository

ProgressService --> ILevelRepository
ProgressService --> IProgressRepository

MissionService --> IMissionRepository
MissionService --> IWalletRepository

GameSessionService --> ILevelRepository
GameSessionService --> IProgressRepository
GameSessionService --> IGameSessionRepository


' ==================================================
' Repository 인터페이스가 사용하는 모델
' ==================================================

' ..>는 메서드의 매개변수나 반환값 등으로 해당 타입을 사용한다는 뜻이다.
IProfileRepository ..> PlayerProfile
IWalletRepository ..> Wallet
ISettingsRepository ..> GameSettings

ILevelRepository ..> Level
IProgressRepository ..> LevelProgress

IMissionRepository ..> Mission
IGameSessionRepository ..> GameSession


' ==================================================
' Service 계층 반환 결과
' ==================================================

' Repository는 데이터를 반환하고 Service는 처리 결과를 Result로 전달한다.
ProfileService ..> Result
WalletService ..> Result
ProgressService ..> Result
MissionService ..> Result
GameSessionService ..> Result

ProfileService ..> GameError
WalletService ..> GameError
ProgressService ..> GameError
MissionService ..> GameError
GameSessionService ..> GameError

@enduml
